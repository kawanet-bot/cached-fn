{
  "name": "cached-fn",
  "description": "Lightweight and lazy cached function with TTL, negative TTL, and item limit controls.",
  "version": "1.3.3",
  "author": "@kawanet",
  "bugs": {
    "url": "https://github.com/kawanet/cached-fn/issues"
  },
  "contributors": [
    "kawanet <u-suke@kawa.net>"
  ],
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-multi-entry": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.13.3",
    "mocha": "^11.8.0",
    "rollup": "^4.62.4",
    "terser": "^5.50.0",
    "ts-refine": "^0.6.0",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./types/cached-fn.d.ts",
      "require": "./dist/cached-fn.cjs",
      "import": "./dist/cached-fn.mjs"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "browser/import.js",
    "browser/package.json",
    "dist/cached-fn.cjs",
    "dist/cached-fn.min.js",
    "dist/cached-fn.mjs",
    "dist/package.json",
    "src/*.ts",
    "types/*.d.ts"
  ],
  "homepage": "https://github.com/kawanet/cached-fn",
  "keywords": [
    "cache",
    "caching",
    "lazy",
    "memoize"
  ],
  "license": "MIT",
  "main": "./dist/cached-fn.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawanet/cached-fn.git"
  },
  "scripts": {
    "build": "make -C builder",
    "fixpack": "fixpack",
    "prepack": "make -C builder is-buildable",
    "prepare": "make -C builder is-not-buildable 2> /dev/null || make -C builder clean all test",
    "test": "make -C builder test",
    "test-bundled": "make -C builder test-bundled",
    "ts-refine": "./node_modules/.bin/ts-refine format && ./node_modules/.bin/ts-refine imports"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./types/cached-fn.d.ts"
}
